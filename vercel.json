{
  "rewrites": [
    { "source": "/midia/:path*", "destination": "/projetos/central-inteligencia/midia/:path*" },
    { "source": "/", "destination": "/projetos/central-inteligencia/central-inteligencia-v1.1.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
