# segredos — .env em qualquer pasta (mantém .env.exemplo rastreado)
.env
**/.env
!**/.env.exemplo

# segredos extras — chaves/credenciais locais em qualquer pasta
*.secret
*.secret.*
**/secrets/
*-credentials.json
*.pem
*.key

# coletor / python
**/coletor/__pycache__/
*.pyc

# logs e backups
**/coletor/logs/
**/backup/*.bak.html
**/backup/*.log

# config local / ferramentas
.DS_Store
.playwright-mcp/
.claude/
.vercel/
.superpowers/
.serena/
**/.temp/

# node
**/node_modules/

