# segredos — .env em qualquer pasta (mantém .env.exemplo rastreado)
.env
**/.env
!**/.env.exemplo

# segredos extras — chaves/credenciais locais em qualquer pasta
*.secret
*.secret.*
**/secrets/
*-credentials.json
*.pem
*.key

# coletor / python
**/coletor/__pycache__/
*.pyc

# logs e backups
**/coletor/logs/
**/backup/*.bak.html
**/backup/*.log

# config local / ferramentas
.DS_Store
.playwright-mcp/
.claude/
.vercel/
.superpowers/
.serena/
**/.temp/

# node
**/node_modules/

# monitor local do coletor (utilitário; já lê do .env, sem credencial embutida)
coletor/np-poll.mjs
coletor/np-watch.mjs
coletor/bling-reauth.mjs
# one-off TEMP com PII real (e-mails/IDs de share) — não versionar
coletor/od-reinvite.mjs
# arte pesada de origem (não é asset do app)
midia/elementos/Modern AI Office With Focus and Lounge Areas.png
gestor-briefings.json
gestor-lab.html
noticias-sample.json

node_modules
dist

# fotos de produto baixadas do Bling (cache local p/ criativos F2)
coletor/fotos-bling/
# cache de recortes (rembg) e fotos baixadas do Bling p/ recorte (F3 task 8)
coletor/fotos-cutout/
coletor/fotos-baixadas/
# acervo local de fotos das bolsas COM MODELO (organizado por SKU) usado p/ montar o
# fotos-modelo-map.json dos criativos; ~1GB, fica local (fábrica lê por URL, não daqui)
coletor/fotos_por_sku/

# Arquivos de laboratório (CSS/HTML extraídos pra conferir tela sem login).
# São temporários por natureza — um deles escapou pro commit em 2026-07-29.
public/lab-*
__repro/

# Sessão real gravada em arquivo por ferramenta de automação (login do
# claudecode@rbvcompany.com para abrir tela sem digitar senha).
#
# É token VIVO: o access_token vale 1 hora, mas o refresh_token que vem junto
# emite sessões novas sem prazo. Duas razões para nunca versionar:
#   1. `public/` é publicado — um commit levaria o token para a internet;
#   2. várias sessões editam este repo ao mesmo tempo, e um `git add -A` distraído
#      basta. Em 06/08/2026 o arquivo existia solto na árvore, fora do .gitignore.
#      Não vazou (não estava no git, e o rewrite do vercel.json devolve index.html),
#      mas foi por pouco e por acidente, não por desenho.
# O lugar certo é FORA de public/, com permissão 600.
public/_sessao-temp.json
public/*sessao*.json
public/*.session.json
