# Credenciais do coletor de notícias (Portal de Notícias)
# Copie este arquivo para ".env" (na mesma pasta) e preencha a chave.
# O .env é ignorado pelo git (ver .gitignore) — NUNCA versione a service key.

# URL do projeto Supabase (público)
SUPABASE_URL=https://kounqtdoioootxqegkij.supabase.co

# SERVICE ROLE key (Supabase > Project Settings > API > service_role).
# Tem permissão total e ignora RLS — use SOMENTE no servidor/automação,
# JAMAIS no index.html ou em qualquer código que vá pro navegador.
SUPABASE_SERVICE_KEY=cole_aqui_a_service_role_key
